
{% assign bs_collection = collections[section.settings.collection] %}

<div class="ea-bs" style="padding-block-start: {{ section.settings.padding_top }}px; padding-block-end: {{ section.settings.padding_bottom }}px;">
  <div class="ea-bs__header">
    <h2 class="ea-bs__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="ea-bs__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="ea-bs__scroll-wrapper">
    <div class="ea-bs__track">
      {% if bs_collection != blank and bs_collection.products_count > 0 %}
        {% for product in bs_collection.products limit: section.settings.max_products %}
          <div class="ea-bs-card">
            <div class="ea-bs-card__media">
              <span class="ea-bs-card__badge">Best Seller</span>
              <button class="ea-bs-card__wishlist" aria-label="Add to wishlist" type="button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
              <a href="{{ product.url }}" class="ea-bs-card__img-link" tabindex="-1" aria-hidden="true">
                {% if product.featured_image %}
                  {{ product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'ea-bs-card__img',
                      alt: product.featured_image.alt | default: product.title,
                      widths: '220, 360, 520, 800',
                      sizes: '(min-width: 750px) 260px, 220px',
                      width: product.featured_image.width,
                      height: product.featured_image.height,
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="ea-bs-card__img-placeholder">{{ product.title | slice: 0 }}</div>
                {% endif %}
              </a>
            </div>

            <div class="ea-bs-card__body">
              <a href="{{ product.url }}" class="ea-bs-card__name-link">
                <h3 class="ea-bs-card__name">{{ product.title }}</h3>
              </a>

              {% if product.description != blank %}
                <p class="ea-bs-card__desc">{{ product.description | strip_html | truncatewords: 10 }}</p>
              {% endif %}

              <div class="ea-bs-card__stars" aria-label="Rated 5 out of 5 stars">⭐⭐⭐⭐⭐</div>

              <div class="ea-bs-card__price">
                {% if product.compare_at_price > product.price %}
                  <span class="ea-bs-card__price--sale">{{ product.price | money }}</span>
                  <s class="ea-bs-card__price--compare">{{ product.compare_at_price | money }}</s>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </div>

              <form method="post" action="/cart/add" class="ea-bs-card__form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="ea-bs-card__atc">
                  {% if product.available %}
                    Add to Cart
                  {% else %}
                    Sold Out
                  {% endif %}
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p class="ea-bs__empty">Select a collection in the theme editor to display products.</p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ea-bs {
    background-color: #fdf8f2;
    overflow: hidden;
  }

  .ea-bs__header {
    text-align: center;
    padding-inline: 1.5rem;
    margin-block-end: 2.5rem;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    margin-block-end: 2.5rem;
  }

  .ea-bs__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: #1a3a2a;
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-block-end: 0.5rem;
  }

  .ea-bs__subheading {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: #5a6a5e;
    letter-spacing: 0.02em;
  }

  /* Scrollable track */
  .ea-bs__scroll-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(26, 58, 42, 0.25) transparent;
    padding-inline: max(1.5rem, calc((100vw - var(--page-width, 1200px)) / 2));
    padding-block-end: 1rem;
  }

  .ea-bs__scroll-wrapper::-webkit-scrollbar {
    height: 4px;
  }

  .ea-bs__scroll-wrapper::-webkit-scrollbar-track {
    background: transparent;
  }

  .ea-bs__scroll-wrapper::-webkit-scrollbar-thumb {
    background-color: rgba(26, 58, 42, 0.25);
    border-radius: 4px;
  }

  .ea-bs__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    scroll-snap-type: x mandatory;
  }

  .ea-bs__empty {
    font-family: 'Inter', system-ui, sans-serif;
    color: #888;
    padding: 2rem;
    text-align: center;
  }

  /* Card */
  .ea-bs-card {
    width: 260px;
    flex-shrink: 0;
    background-color: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(26, 58, 42, 0.08);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .ea-bs-card:hover {
    box-shadow: 0 6px 24px rgba(26, 58, 42, 0.15);
    transform: translateY(-3px);
  }

  /* Media area */
  .ea-bs-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f5f0e8;
  }

  .ea-bs-card__img-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ea-bs-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .ea-bs-card:hover .ea-bs-card__img {
    transform: scale(1.04);
  }

  .ea-bs-card__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-family: 'Cormorant Garamond', serif;
    color: #1a3a2a;
    background-color: #e8f0ea;
  }

  /* Badge */
  .ea-bs-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: #1a3a2a;
    color: #f5f0e8;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    z-index: 1;
  }

  /* Wishlist */
  .ea-bs-card__wishlist {
    position: absolute;
    top: 8px;
    right: 10px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1a3a2a;
    z-index: 1;
    transition: background-color 0.2s ease, color 0.2s ease;
    padding: 0;
  }

  .ea-bs-card__wishlist:hover {
    background-color: #1a3a2a;
    color: #f5f0e8;
  }

  .ea-bs-card__wishlist svg {
    pointer-events: none;
  }

  /* Body */
  .ea-bs-card__body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .ea-bs-card__name-link {
    text-decoration: none;
    color: inherit;
  }

  .ea-bs-card__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #1a3a2a;
    line-height: 1.3;
    margin: 0;
  }

  .ea-bs-card__name-link:hover .ea-bs-card__name {
    color: #2d5016;
  }

  .ea-bs-card__desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    color: #6b7c70;
    line-height: 1.5;
    margin: 0;
  }

  .ea-bs-card__stars {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .ea-bs-card__price {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a3a2a;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.2rem;
  }

  .ea-bs-card__price--sale {
    color: #1a3a2a;
  }

  .ea-bs-card__price--compare {
    font-weight: 400;
    color: #aab4ae;
    font-size: 0.82rem;
  }

  /* ATC */
  .ea-bs-card__form {
    margin-block-start: auto;
    padding-block-start: 0.75rem;
  }

  .ea-bs-card__atc {
    display: block;
    width: 100%;
    padding: 0.7rem 1rem;
    background-color: transparent;
    color: #1a3a2a;
    border: 1.5px solid #1a3a2a;
    border-radius: 4px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
    appearance: none;
    -webkit-appearance: none;
  }

  .ea-bs-card__atc:hover {
    background-color: #1a3a2a;
    color: #f5f0e8;
  }

  /* Mobile: narrower cards, still scrollable */
  @media screen and (max-width: 749px) {
    .ea-bs-card {
      width: 220px;
    }

    .ea-bs__scroll-wrapper {
      padding-inline: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bestsellers Carousel",
  "class": "ea-bestsellers-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved By Customers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "India's most trusted Ayurvedic remedies"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Carousel",
      "settings": {
        "heading": "Loved By Customers",
        "subheading": "India's most trusted Ayurvedic remedies",
        "max_products": 8
      }
    }
  ]
}
{% endschema %}
